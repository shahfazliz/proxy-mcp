{
  "responseTransforms": [
    {
      "method": "GET",
      "url": "resp-test",
      "regex": false,
      "patches": [
        {
          "path": "items[]",
          "set": {
            "n": "p"
          }
        }
      ]
    }
  ],
  "requestTransforms": [
    {
      "method": "GET",
      "url": "test",
