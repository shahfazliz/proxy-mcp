      "setHeaders": {
        "x-custom": "hello"
      },
      "removeHeaders": [
        "x-old"
      ],
      "setQuery": {
        "include": "extended"
      }
    },
    {
      "method": "POST",
      "url": "req-test",
      "regex": false,
      "setHeaders": {
        "x-foo": "bar"
      }
    },
    {
      "method": "GET",
      "url": "test",
      "regex": false,
      "setHeaders": {
        "x-updated": "yes"
      }
    }
  ]
}